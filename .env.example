# ===== 飞书应用配置 =====
# 飞书开放平台 -> 应用凭证
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 飞书事件订阅 -> 加密策略（Encrypt Key 与 Verification Token）
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFY_TOKEN=

# ===== LLM 模型配置 =====
# API Key（如本地模型无需鉴权可留空）
LLM_API_KEY=
# OpenAI 兼容接口地址
LLM_BASE_URL=http://localhost:11434/v1
# 模型名称
LLM_MODEL=qwen3.8:27b-mlx

# ===== 服务配置 =====
# HTTP 服务监听端口
SERVER_PORT=48080
